## Example .env file for local development
## Copy this file to `.env` (not checked into source control) and fill in your real credentials.

# SQL Server connection examples. Choose one format and set DB_CONN accordingly.

# 1) SQL Authentication (username/password)
# DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your_server;DATABASE=your_db;UID=your_user;PWD=your_password;Encrypt=no

# 2) Windows Integrated Authentication (no username/password) - recommended when the server accepts Windows auth
#    Uses the Windows identity of the process that runs the script.
# Plain (no encryption):
# DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your_server;DATABASE=your_db;Trusted_Connection=yes;Encrypt=no
# Encrypted (trust server certificate if needed):
# DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your_server;DATABASE=your_db;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes

# If you need a named instance or port, use SERVER=myhost\INSTANCE or SERVER=tcp:myhost,1433

# Logical table name used by the import script when inserting into IngestColumnMap
# Example: trans.IngestTransmittal
INGEST_TABLE=trans.[2024TransmittalForwardFill]
# Staging table used by scripts and stored-procs (optional override)
# Example: trans.Staging_2024Transmittal
STAGING_TABLE=trans.[Staging_2024Transmittal]
# Examples to copy into your local `.env` (uncomment and edit values):

# Example (SQL authentication):
# DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};Server=sql.host;Database=MyDb;UID=myuser;PWD=mypassword;Encrypt=yes;TrustServerCertificate=yes

# Example (Windows Integrated / Trusted Connection):
# DB_CONN=DRIVER={ODBC Driver 18 for SQL Server};Server=sql.host;Database=MyDb;Trusted_Connection=yes;Encrypt=no

# If you need a named instance or port, use SERVER=myhost\INSTANCE or SERVER=tcp:myhost,1433

# Staging / final table examples (uncomment to override defaults):
# STAGING_TABLE=trans.[Staging_2024Transmittal]
# INGEST_TABLE=trans.[2024TransmittalForwardFill]

# Note: for integrated auth testing you can launch a shell with `runas /netonly /user:DOMAIN\\username` and start
# the server inside that shell so the process can obtain domain credentials for SSPI/impersonation testing.

# Optional impersonation credentials for scripts that call win32security.LogonUser
# (for example scripts/create_flat_view.py, scripts/create_project_view.py,
# and scripts/wire_transmittal_projects_normalized_ingest.py).
# If set, these scripts impersonate this account before opening pyodbc.
# IMPERSONATE_USER=NET\DCUA235_SA
# IMPERSONATE_PASSWORD=your_password

